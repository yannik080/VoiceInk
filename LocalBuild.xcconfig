// LocalBuild.xcconfig
// Build configuration for local builds with an ad-hoc fallback when no Apple Development identity is available.
// Applied only by `make local` on top of Release; normal Xcode configurations are unchanged.

// make local always passes CODE_SIGN_IDENTITY, including its ad-hoc fallback.
// Do not set it here: -xcconfig overrides even command-line build settings.
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

// Entitlements are set via absolute path in the Makefile command line
// (relative paths break SPM package targets that resolve from their own source root)

// Add LOCAL_BUILD compilation flag so Swift code can use #if LOCAL_BUILD
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) LOCAL_BUILD
